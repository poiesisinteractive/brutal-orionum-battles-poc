<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Builds reproductibles (même source = mêmes binaires). -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Versions BRUTAL alignées sur les samples du dépôt BRUTAL (c4c62f5, 2026-11). -->
  <PropertyGroup>
    <BrutalCoreVersion>2026.10.4</BrutalCoreVersion>
    <BrutalNumericsVersion>2026.10.2</BrutalNumericsVersion>
    <BrutalCollectionsVersion>2026.10.2</BrutalCollectionsVersion>
    <BrutalConcurrencyVersion>2026.10.2</BrutalConcurrencyVersion>
    <!-- Visualiseur (fenêtre, OpenGL, UI). -->
    <BrutalGlfwVersion>2026.10.5</BrutalGlfwVersion>
    <BrutalOpenGlVersion>2026.10.2</BrutalOpenGlVersion>
    <BrutalImGuiVersion>2026.10.3</BrutalImGuiVersion>
  </PropertyGroup>

</Project>
